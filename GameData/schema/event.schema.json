{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/audreygontier334-lang/3D/GameData/schema/event.schema.json",
  "title": "Événement automatique",
  "type": "object",
  "required": [
    "id",
    "time",
    "grants"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVT_[A-Z0-9_]+$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "unless": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CLU|DED|FLAG)_[A-Z0-9_]+$"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CLU|DED|FLAG)_[A-Z0-9_]+$"
      }
    },
    "dialogue": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallback": {
      "type": "boolean",
      "description": "Rattrapage garantissant l'accès à une preuve"
    },
    "ends_chapter": {
      "type": "boolean"
    }
  }
}
