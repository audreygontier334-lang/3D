{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/audreygontier334-lang/3D/GameData/schema/puzzle.schema.json",
  "title": "Énigme",
  "type": "object",
  "required": [
    "id",
    "title",
    "axis",
    "duo",
    "mandatory",
    "inputs",
    "produces",
    "answer",
    "hints",
    "recovery"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PZ_[A-Z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "axis": {
      "type": "string"
    },
    "duo": {
      "type": "boolean"
    },
    "mandatory": {
      "type": "boolean"
    },
    "interaction": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CLU|DED|FLAG)_[A-Z0-9_]+$"
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CLU|DED|FLAG)_[A-Z0-9_]+$"
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "type"
      ]
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UI_HINT_[A-Z0-9_]+$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "red_herrings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CLU_[A-Z0-9_]+$"
      }
    },
    "wrong": {
      "type": "object"
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "note_audrey": {
      "type": "string"
    }
  }
}
