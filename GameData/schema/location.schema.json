{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/audreygontier334-lang/3D/GameData/schema/location.schema.json",
  "title": "Lieu",
  "type": "object",
  "required": [
    "id",
    "name",
    "zone",
    "env"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LOC_[A-Z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "zone": {
      "type": "string",
      "pattern": "^Z_[A-Z0-9_]+$"
    },
    "env": {
      "type": "string",
      "pattern": "^ENV_[A-Z0-9_]+$"
    },
    "available_from": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "available_until": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    }
  }
}
