  "scenes": [
    {
      "id": "DLG_C3_BRIEFING",
      "context": "INT_C3_BRIEFING. Mercredi matin, bureau d'Arbelot.",
      "location": "LOC_BRIGADE",
      "lines": [
        {
          "id": "DLG_C3_BRIEFING_01",
          "speaker": "ARBELOT",
          "text": "Jeudi, 5 h 30, quai du Maren Sofie. Julien conduira le camion ; nous serons là.",
          "intent": "Poser l'opération",
          "emotion": "froid, méthodique"
        },
        {
          "id": "DLG_C3_BRIEFING_02",
          "speaker": "ARBELOT",
          "text": "Qui est au courant : mon équipe, Julien, et la famille, que je rassurerai ce soir sans détail. Les douanes, à 4 h seulement.",
          "intent": "Liste fermée, base de la déduction",
          "emotion": "précis"
        },
        {
          "id": "DLG_C3_BRIEFING_03",
          "speaker": "ARBELOT",
          "text": "Julien dormira ici. Son téléphone reste chez nous.",
          "intent": "Exclure Julien de la fuite",
          "emotion": "neutre"
        }
      ]
    },
    {
      "id": "DLG_C3_JULIEN",
      "context": "INT_C3_JULIEN. Salle d'audition (PZ_C3_01).",
      "location": "LOC_BRIGADE",
      "lines": [
        {
          "id": "DLG_C3_JULIEN_01",
          "speaker": "JULIEN",
          "text": "S'ils apprennent que je parle, c'est fini pour elle.",
          "intent": "Peur",
          "emotion": "brisé"
        },
        {
          "id": "DLG_C3_JULIEN_02",
          "speaker": "HEROINE",
          "text": "Ils vous ont promis de la rendre. Hier soir, ils l'ont déjà déplacée. Ils ne tiennent pas parole.",
          "intent": "Bon argument",
          "emotion": "douce, ferme",
          "requires": {
            "outcome": "succes"
          }
        },
        {
          "id": "DLG_C3_JULIEN_03",
          "speaker": "JULIEN",
          "text": "Des cartons de médicaments, des notices fausses. J'ai dit que j'arrêtais. Jeudi, 5 h 30, je conduis au Maren Sofie et je donne les clés à la femme. Qui dirige ? Si je le dis, elle est morte.",
          "intent": "Témoignage ; il ne nomme personne",
          "emotion": "à voix basse",
          "requires": {
            "outcome": "succes"
          }
        }
      ]
    },
    {
      "id": "DLG_C3_JULIEN_SE_FERME",
      "context": "BR_C3_JULIEN_SE_FERME.",
      "location": "LOC_BRIGADE",
      "lines": [
        {
          "id": "DLG_C3_JULIEN_SE_FERME_01",
          "speaker": "JULIEN",
          "text": "Je n'ai rien à vous dire.",
          "intent": "Conséquence d'un mauvais argument",
          "emotion": "fermé"
        }
      ]
    },
    {
      "id": "DLG_C3_JULIEN_CEDE",
      "context": "EVT_C3_JULIEN_CEDE (rattrapage).",
      "location": "LOC_BRIGADE",
      "lines": [
        {
          "id": "DLG_C3_JULIEN_CEDE_01",
          "speaker": "ARBELOT",
          "text": "Il a parlé. Jeudi, 5 h 30, quai du Maren Sofie.",
          "intent": "Rattrapage",
          "emotion": "sobre"
        }
      ]
    },
    {
      "id": "DLG_C3_DARRIGADE",
      "context": "INT_C3_DARRIGADE. Accueil de l'entrepôt, visite autorisée par les douanes.",
      "location": "LOC_ENTREPOT_ACCUEIL",
      "lines": [
        {
          "id": "DLG_C3_DARRIGADE_01",
          "speaker": "DARRIGADE",
          "text": "Un café ? Je vous en prie, visitez tout. Et demain matin, ça se passera comment, concrètement ?",
          "intent": "Graine : curiosité appuyée",
          "emotion": "affable"
        },
        {
          "id": "DLG_C3_DARRIGADE_02",
          "speaker": "HEROINE",
          "text": "Je ne sais pas. Je suis juste là pour la chienne.",
          "intent": "Méfiance sans accusation",
          "emotion": "neutre"
        }
      ]
    },
    {
      "id": "DLG_C3_DOCUMENTS",
      "context": "INT_C3_DOCUMENTS. Bons, pesées et scellés en plein écran (PZ_C3_02).",
      "location": "LOC_ENTREPOT_ACCUEIL",
      "lines": [
        {
          "id": "DLG_C3_DOCUMENTS_01",
          "speaker": "DOUANIER",
          "text": "Trois lots partent jeudi. Comparez ce qui est déclaré et ce qui est pesé.",
          "intent": "Poser l'énigme",
          "emotion": "professionnel"
        },
        {
          "id": "DLG_C3_DOCUMENTS_02",
          "speaker": "DOUANIER",
          "text": "Quai 4 : cent quatre-vingts kilos de trop, scellés hors série. On le bloque.",
          "intent": "Conclusion",
          "emotion": "grave",
          "requires": {
            "outcome": "succes"
          }
        }
      ]
    },
    {
      "id": "DLG_C3_DOCS_MAUVAIS_LOT",
      "context": "BR_C3_DOCS_MAUVAIS_LOT.",
      "location": "LOC_ENTREPOT_ACCUEIL",
      "lines": [
        {
          "id": "DLG_C3_DOCS_MAUVAIS_LOT_01",
          "speaker": "DOUANIER",
          "text": "Ce lot-là est conforme. On refait tout, ça va prendre du temps.",
          "intent": "Conséquence",
          "emotion": "agacé"
        }
      ]
    },
    {
      "id": "DLG_C3_DOUANES",
      "context": "EVT_C3_DOUANES_CONTRE_VERIF (rattrapage).",
      "location": "LOC_ENTREPOT_ACCUEIL",
      "lines": [
        {
          "id": "DLG_C3_DOUANES_01",
          "speaker": "DOUANIER",
          "text": "Contre-vérification faite : c'est le quai 4.",
          "intent": "Rattrapage",
          "emotion": "sec"
        }
      ]
    },
    {
