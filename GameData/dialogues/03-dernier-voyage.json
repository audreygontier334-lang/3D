        {
          "id": "DLG_C3_OPERATION_02",
          "speaker": "ARBELOT",
          "text": "Message reçu à 3 h 02 : « Change de plan, tu y vas seul. » Les douanes ne savaient rien avant 4 h.",
          "intent": "Heure de la fuite",
          "emotion": "glacial"
        }
      ]
    },
    {
      "id": "DLG_C3_ARIANE_VOITURE",
      "context": "INT_C3_ARIANE_VOITURE (PZ_C3_04).",
      "location": "LOC_QUAIS_VOITURE",
      "lines": [
        {
          "id": "DLG_C3_ARIANE_VOITURE_01",
          "speaker": "CHIENNE",
          "text": "[fait le tour de la citadine, gratte la portière passager, s'assied]",
          "intent": "Marquage",
          "emotion": "sûre",
          "requires": {
            "outcome": "succes"
          }
        },
        {
          "id": "DLG_C3_ARIANE_VOITURE_02",
          "speaker": "HEROINE",
          "text": "Un téléphone sous le siège. Et un ticket d'essence : Lande-Haute, 5 h 40.",
          "intent": "Deux indices de la suite",
          "emotion": "fébrile",
          "requires": {
            "outcome": "succes"
          }
        }
      ]
    },
    {
      "id": "DLG_C3_FOUILLE_MAUVAISE",
      "context": "BR_C3_FOUILLE_MAUVAISE.",
      "location": "LOC_QUAIS_VOITURE",
      "lines": [
        {
