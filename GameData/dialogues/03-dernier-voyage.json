      "context": "EVT_C3_OPERATION, 6 h 20.",
      "location": "LOC_QUAIS_PLANQUE",
      "lines": [
        {
          "id": "DLG_C3_OPERATION_01",
          "speaker": "GENDARME",
          "text": "Ce n'est pas elle. Un homme, dans sa voiture grise. On l'interpelle.",
